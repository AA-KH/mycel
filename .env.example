# Example Environment Variables
# Copy this file to .env and fill in your actual values

# --- JWT Authentication ---
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256

# --- MongoDB Configuration ---
MONGODB_URL=mongodb://localhost:27017/office

# --- RabbitMQ Configuration ---
SERVICE_USER_RABBITMQ=admin
SERVICE_PASSWORD_RABBITMQ=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# --- Frontend API URLs ---
# Update these based on your deployment environment
VITE_API_URL=http://localhost:8000

# --- Cloudinary Configuration (Phase 7) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- External Tools APIs ---
SERPER_API_KEY=your_serper_key_here
FIRECRAWL_API_KEY=your_firecrawl_key_here
