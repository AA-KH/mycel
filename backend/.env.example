# ============================================================
#  Mycel — Environment Configuration
#
#  Copy this file to .env and fill in your actual values.
#  NEVER commit your real .env to version control.
#  All keys here are placeholders — none are real credentials.
# ============================================================


# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_NAME=Mycel
APP_ENV=development          # development | staging | production
DEBUG=true
HOST=0.0.0.0
PORT=8000


# ─────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ─────────────────────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────────────────────
# Local dev:   mongodb://localhost:27017/office
# Atlas:       mongodb+srv://<user>:<pass>@cluster.mongodb.net/office
MONGODB_URL="mongodb://localhost:27017/office"
MONGODB_DATABASE=office


# ─────────────────────────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/


# ─────────────────────────────────────────────────────────────
# ArmorIQ Security Gateway
# ─────────────────────────────────────────────────────────────
# SECURITY_PROVIDER_MODE controls which security provider is active:
#   "armoriq"  → ArmorIQ production provider (requires ARMORIQ_API_KEY)
#   "mock"     → MockSecurityProvider — always ALLOW (local dev only)
#
# For the Real Estate demo, "mock" lets you run without an ArmorIQ key.
# Switch to "armoriq" before any demo to a real audience.
SECURITY_PROVIDER_MODE="mock"
ARMORIQ_API_KEY=""
ARMORIQ_TIMEOUT_MS=5000


# ─────────────────────────────────────────────────────────────
# Groq LLM — Global Key Pool
# ─────────────────────────────────────────────────────────────
# Free API keys: https://console.groq.com
# GROQ_API_KEY_1 = primary key
# GROQ_API_KEY_2 = automatic failover if primary is rate-limited
#
# The Real Estate domain uses: llama-3.1-8b-instant
#   - Intent classification   (T=0.0, max_tokens=256)
#   - Response generation     (T=0.3, max_tokens=512)
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# ─────────────────────────────────────────────────────────────
# Extreme Load Balancer Pool (For Mass Concurrency)
# ─────────────────────────────────────────────────────────────
# If you are running massive test scripts (e.g. 5 agents simultaneously),
# you can provide a comma-separated list of 25+ Groq API keys here.
# The system will automatically load-balance across all of them and 
# route around 429 Rate Limits with zero downtime.
#
# EXAMPLE FORMAT (No spaces between keys, just commas):
# GROQ_EXTREME_POOL="gsk_firstKeyABC123,gsk_secondKeyXYZ789,gsk_thirdKeyQWE456"
GROQ_EXTREME_POOL=""

# Queue system to prevent hitting all keys with a massive spike at once
# Default is 3. Increase if you have 100+ keys or higher limits.
GROQ_MAX_CONCURRENCY=3
 

# ─────────────────────────────────────────────────────────────
# Gemini (SlideBot / Google AI)
# ─────────────────────────────────────────────────────────────
# Required for SlideBot AI (presentation generation).
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────
# Storage — Cloudinary
# ─────────────────────────────────────────────────────────────
# Required for production artifact storage (images, files, etc.)
# Leave empty to use the local MockStorageProvider in development.
# Get credentials at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ─────────────────────────────────────────────────────────────
# Image Generation — Cloudflare Image Worker
# ─────────────────────────────────────────────────────────────
# Used by Riya's image generation tool as a fallback/proxy.
CLOUDFLARE_IMAGE_WORKER_KEY=


# ─────────────────────────────────────────────────────────────
# Image Generation — ComfyUI (Local)
# ─────────────────────────────────────────────────────────────
# Point this at a running ComfyUI instance.
# Riya falls back to Cloudflare/Pollinations if ComfyUI is not running.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=
COMFYUI_TIMEOUT_SECONDS=120
COMFYUI_MAX_RETRIES=2
COMFYUI_DEFAULT_WIDTH=512
COMFYUI_DEFAULT_HEIGHT=512
COMFYUI_DEFAULT_STEPS=25
COMFYUI_LIVE_TEST=false

# ComfyUI Video (Wan 2.1 1.3B — ~8GB VRAM, 480P)
COMFYUI_WAN_MODEL=wan2.1-i2v-1.3B-480P.safetensors
COMFYUI_VIDEO_DEFAULT_FPS=16
COMFYUI_VIDEO_MAX_DURATION=8


# ─────────────────────────────────────────────────────────────
# Design Tools — Penpot
# ─────────────────────────────────────────────────────────────
# Required for Riya's design.canvas tool.
# Personal access token from: https://design.penpot.app → Profile → Access Tokens
PENPOT_ACCESS_TOKEN=


# ─────────────────────────────────────────────────────────────
# Website Generation — Builder.io
# ─────────────────────────────────────────────────────────────
# Required for WebsiteGeneratorTool using BuilderWebsiteProvider
# Get credentials at: https://builder.io/c/docs/using-your-api-key
BUILDER_IO_PUBLIC_KEY=
BUILDER_IO_PRIVATE_KEY=


# ─────────────────────────────────────────────────────────────
# Redis (optional)
# ─────────────────────────────────────────────────────────────
# Used for conversation state caching in production.
# The Real Estate domain uses in-memory state by default.
# Set this to enable Redis-backed ConversationState for multi-worker deployments.
# Format: redis://:password@host:port/db_number
REDIS_URL=


# ─────────────────────────────────────────────────────────────
# Real Estate Domain Demo
# ─────────────────────────────────────────────────────────────

# Voice mode for VoiceGateway:
#   "browser"       → Web Speech API client-side (default, no setup needed)
#   "voicelink"     → VoiceLink WebSocket integration (TRAI-compliant telephony)
#   "groq_whisper"  → Groq Whisper endpoint for server-side STT
RE_VOICE_MODE=browser

# Default demo customer ID (auto-seeded into the customer store at startup)
RE_DEMO_CUSTOMER_ID=kaushal

# MongoDB collection names for property data (override to namespace per environment)
RE_COLLECTION_PROPERTIES=re_properties
RE_COLLECTION_INGESTION_JOBS=re_ingestion_jobs

# Maximum properties returned per search query (hard cap, regardless of ?limit= param)
RE_MAX_SEARCH_RESULTS=50

# Legal knowledge base version — increment when seeded docs are updated
RE_LEGAL_KB_VERSION=1

# Excel ingestion: max file size in MB (enforced client-side and server-side)
RE_MAX_UPLOAD_SIZE_MB=50


# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────
# Set this to your backend URL. Used by Vite at build time.
VITE_API_URL=http://localhost:8000
GEMINI_API_KEY_2="your-second-gemini-key"


SERPER_API_KEY=your_serper_key_here
FIRECRAWL_API_KEY=

OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

ACLED_EMAIL=your_acled_email_here
ACLED_API_KEY=your_acled_api_key_here

# ─────────────────────────────────────────────────────────────
# Resilience External APIs (No Keys Required)
# ─────────────────────────────────────────────────────────────
# GDACS (Disaster Alerts): Free public API
# NASA EONET (Anomalies): Free public API
# World Bank (Economics): Free public API
# Frankfurter (Live Exchange Rates): Free public API

# ─────────────────────────────────────────────────────────────
# Architecture / Rohan APIs
# ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_key_here
MARINE_TRAFFIC_API_KEY=your_key_here