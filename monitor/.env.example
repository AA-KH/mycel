# ============================================================
# Mycel Monitor — Configuration
# ============================================================
# Copy to .env and fill in values.

# ── Application ──
MYCEL_MONITOR_DEBUG=false
MYCEL_MONITOR_HOST=0.0.0.0
MYCEL_MONITOR_PORT=8100

# ── Database ──
MYCEL_MONITOR_DB_PATH=monitor_data.db

# ── LLM (Groq) ──
# Required for semantic analysis. Without it, the monitor runs
# in deterministic-only mode (still fully functional).
GROQ_API_KEY=
GROQ_API_KEY_2=
MYCEL_MONITOR_LLM_PROVIDER=groq
MYCEL_MONITOR_LLM_MODEL=openai/gpt-oss-120b

# ── Alert Dispatch ──
# Webhook URL for the main Mycel organization.
# If not set, alerts are logged but not dispatched.
MYCEL_MONITOR_ALERT_WEBHOOK_URL=

# ── Source: GDELT ──
MYCEL_MONITOR_GDELT_ENABLED=true
# No API key needed

# ── Source: GDACS ──
MYCEL_MONITOR_GDACS_ENABLED=true
# No API key needed

# ── Source: USGS ──
MYCEL_MONITOR_USGS_ENABLED=true
# No API key needed

# ── Source: Open-Meteo ──
MYCEL_MONITOR_OPENMETEO_ENABLED=true
# No API key needed

# ── Source: changedetection.io (Tier 2 — Optional) ──
MYCEL_MONITOR_CHANGEDETECTION_ENABLED=false
MYCEL_MONITOR_CHANGEDETECTION_URL=
MYCEL_MONITOR_CHANGEDETECTION_API_KEY=

# ── Source: WTO Timeseries API (requires free API key) ──
MYCEL_MONITOR_WTO_ENABLED=true
WTO_API_KEY=
# Register at https://apiportal.wto.org for free key

# ── Source: Global Trade Alert (requires commercial license) ──
MYCEL_MONITOR_GLOBAL_TRADE_ALERT_ENABLED=true
GTA_API_URL=
GTA_API_KEY=

# ── Source: WITS / World Bank (public, no key needed) ──
MYCEL_MONITOR_WITS_ENABLED=true

# ── Scheduling ──
MYCEL_MONITOR_DEFAULT_POLL_INTERVAL=3600
MYCEL_MONITOR_GDELT_POLL_INTERVAL=900
MYCEL_MONITOR_GDACS_POLL_INTERVAL=600
MYCEL_MONITOR_USGS_POLL_INTERVAL=300
MYCEL_MONITOR_OPENMETEO_POLL_INTERVAL=1800
MYCEL_MONITOR_WTO_POLL_INTERVAL=86400
MYCEL_MONITOR_GTA_POLL_INTERVAL=86400
MYCEL_MONITOR_WITS_POLL_INTERVAL=86400

# ── Severity Thresholds ──
MYCEL_MONITOR_SEVERITY_CRITICAL_THRESHOLD=0.75
MYCEL_MONITOR_SEVERITY_WARNING_THRESHOLD=0.50
MYCEL_MONITOR_SEVERITY_WATCH_THRESHOLD=0.25
